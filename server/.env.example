# Local development — copy to `.env` and fill in secrets.
# Never commit real keys.

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=carbonatix
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Optional: advisor (SSE) + document interpret. Leave empty to run
# emissions/compliance without recommendations / OCR.
ELICE_API_KEY=
ELICE_BASE_URL=
ELICE_MODEL=gpt-5.6-sol

# Optional: Helpy Document Vision (required together with Elice for OCR).
HELPY_BASE_URL=
