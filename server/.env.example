# Local development — copy to `.env` and fill in secrets.
# Never commit real keys.

# Used when you run the API natively (venv + uvicorn). Under Docker this value
# is ignored: `localhost` there means the container itself, so Compose supplies
# the container's URI instead — the bundled `database` service by default, or
# whatever a repo-root `.env` sets. See "Which database the container uses" in
# the README.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=carbonatix
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Optional: advisor (SSE) + document interpret. Leave empty to run
# emissions/compliance without recommendations / OCR.
ELICE_API_KEY=
ELICE_BASE_URL=
ELICE_MODEL=gpt-5.6-sol

# Optional: Helpy Document Vision (required together with Elice for OCR).
HELPY_BASE_URL=

# Optional: re-seed Mongo forecasts from data/forecasts_mvp.json even when
# the forecasts collection is non-empty (1/true/yes).
FORCE_FORECAST_SEED=

# Optional: skip forecast seeding (used by pytest; leave unset in normal runs).
SKIP_FORECAST_SEED=
